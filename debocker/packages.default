# One package per line. 'a | b' installs the first of a and b the release
# has, so names that changed between releases still work. '-name' in a
# packages.<release> file removes a package listed here.

build-essential
autoconf
gawk
flex
bison
gettext
pkg-config

unzip
wget
curl
openssh-client | ssh

libncurses-dev | libncurses5-dev
zlib1g-dev
libbz2-dev
libelf1t64 | libelf1 | libelfg0

ca-certificates
